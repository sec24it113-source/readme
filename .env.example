# Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Server Port
PORT=5000

# PostgreSQL Database URL
# For production (e.g. Render):
# DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/dbname
# For local development with PostgreSQL:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/event_ticket_db
# Optional local fallback when Postgres service is not installed:
# DATABASE_URL=sqlite:///dev.db

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Ticket Hold Timeout in Seconds (10 minutes = 600)
RESERVATION_HOLD_SECONDS=600
