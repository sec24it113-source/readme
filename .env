FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=dev-secret-key-3b4f912e5c6a8d7e0f1a2b3c4d5e6f7a
PORT=5000

# PostgreSQL is the primary required database.
# On Render / Production: Set by Render's managed PostgreSQL.
# In local development without a running PostgreSQL server, fallback to sqlite:///local_dev.db if needed.
DATABASE_URL=sqlite:///local_dev.db
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/event_ticket_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Reservation Hold (10 minutes = 600 seconds)
RESERVATION_HOLD_SECONDS=600
